async function rasterObj(o,scale=4){
  await ensureReady(o);let b=objBox(o);
  if(o.type==='text'){mctx.font=fontStr(o);const Lo=textLayout(mctx,o);const w=Lo.W*(o.hs||1);const m=textMetrics(o);const p=o.fontSize*.35;const left=o.bw?o.x:o.x-w*alignK(o);b={x:left-p,y:o.y-p,w:w+2*p,h:Lo.lines.length*m.L+2*p};}
  const c=document.createElement('canvas');c.width=Math.max(1,Math.ceil(b.w*scale));c.height=Math.max(1,Math.ceil(b.h*scale));const x=c.getContext('2d');x.scale(scale,scale);x.translate(-b.x,-b.y);drawObjCanvas(x,o);return{c,b};
}
const toBytes=async u=>new Uint8Array(await (await fetch(u)).arrayBuffer());
const canvasPng=c=>new Promise(r=>c.toBlob(async b=>r(new Uint8Array(await b.arrayBuffer())),'image/png'));
function makeConv(box,r){const{x:x0,y:y0,width:w,height:h}=box;return(vx,vy)=>{switch(r){case 90:return[x0+vy,y0+vx];case 180:return[x0+w-vx,y0+vy];case 270:return[x0+w-vy,y0+h-vx];default:return[x0+vx,y0+h-vy];}};}
async function buildPdf(d,opt){
  const out=await PDFDocument.create();const libs={},fonts={},imgs={};
  // copy source pages in one batch per source (shares fonts/images), duplicates copied separately
  const firstUse={},copied={};
  d.pages.forEach(pg=>{if(!pg.srcId)return;const k=pg.srcId+':'+pg.srcIndex;if(!firstUse[k])firstUse[k]=pg.key;});
  for(const sid of new Set(d.pages.filter(p=>p.srcId).map(p=>p.srcId))){
    libs[sid]=await PDFDocument.load(sources[sid].bytes,{ignoreEncryption:true,updateMetadata:false});
    applyFormValues(libs[sid],d,sid);
    const idx=[...new Set(d.pages.filter(p=>p.srcId===sid).map(p=>p.srcIndex))];const cps=await out.copyPages(libs[sid],idx);idx.forEach((ix,k)=>copied[sid+':'+ix]=cps[k]);
  }
  for(const pg of d.pages){
    let p;
    if(pg.srcId){const k=pg.srcId+':'+pg.srcIndex;let cp;if(firstUse[k]===pg.key)cp=copied[k];else[cp]=await out.copyPages(libs[pg.srcId],[pg.srcIndex]);p=out.addPage(cp);if(hasPageEdits(pg)){try{hideTextInPage(out,p,(pg.hidden||[]).map(h=>h.r),pg.elemEdits);}catch(e){console.warn('hide on export failed',e);}}}
    else p=out.addPage([pg.w,pg.h]);
    const r=totalRot(pg);p.setRotation(degrees(r));
    let box;try{box=pg.srcId?p.getCropBox():{x:0,y:0,width:pg.w,height:pg.h};}catch(e){box=p.getMediaBox();}
    if(Math.abs(box.width-pg.w)>1||Math.abs(box.height-pg.h)>1){box={x:box.x,y:box.y,width:pg.w,height:pg.h};}
    const conv=makeConv(box,r),rot=degrees(r);
    const place=(x,y,w,h)=>{const a=conv(x,y+h);return{x:a[0],y:a[1],width:w,height:h,rotate:rot};};
    for(const o of [...pg.objects,...await pageFormObjs(d,pg,true)]){
      try{
        if(o.type==='patch'){p.drawRectangle({...place(o.x,o.y,o.w,o.h),color:pdfColor(o.color),opacity:o.opacity??1,borderWidth:0});continue;}
        if(o.type==='highlight'){p.drawRectangle({...place(o.x,o.y,o.w,o.h),color:pdfColor(o.color),opacity:o.opacity??.45,blendMode:BlendMode.Multiply,borderWidth:0});continue;}
        if(o.type==='note'){const a=conv(o.x,o.y),b=conv(o.x+22,o.y+22);const[cr,cg,cb]=hex2rgb(o.color);
          const an=out.context.obj({Type:'Annot',Subtype:'Text',Rect:[Math.min(a[0],b[0]),Math.min(a[1],b[1]),Math.max(a[0],b[0]),Math.max(a[1],b[1])],Contents:PDFHexString.fromText(o.text||''),Name:'Comment',C:[cr/255,cg/255,cb/255],T:PDFHexString.fromText('Folio'),F:4,Open:false});
          p.node.addAnnot(out.context.register(an));continue;}
        if(o.type==='text'&&FONTS[o.font]?.std&&o.font!=='__detected'&&!(o.hs&&Math.abs(o.hs-1)>.01)&&!o.bw&&o.align!=='justify'){
          const fam=STD[FONTS[o.font].std];const nm=fam[(o.bold?1:0)+(o.italic?2:0)];if(!fonts[nm])fonts[nm]=await out.embedFont(StandardFonts[nm]);const f=fonts[nm];
          const lines=o.text.split('\n');lines.forEach(l=>f.encodeText(l));// throws on unsupported chars -> raster fallback
          const m=textMetrics(o);const lw=lines.map(l=>f.widthOfTextAtSize(l,o.fontSize)),LW=Math.max(0,...lw),lft=o.x-LW*alignK(o);lines.forEach((l,k)=>{if(!l)return;const a=conv(lft+(o.align==='center'?(LW-lw[k])/2:o.align==='right'?LW-lw[k]:0),o.y+k*m.L+m.off);p.drawText(l,{x:a[0],y:a[1],size:o.fontSize,font:f,color:pdfColor(o.color),opacity:o.opacity??1,rotate:rot});});continue;}
        if(o.type==='image'){const u=assets[o.asset];let im=imgs[o.asset];if(!im){if(/^data:image\/jpe?g/.test(u))im=await out.embedJpg(await toBytes(u));else if(/^data:image\/png/.test(u))im=await out.embedPng(await toBytes(u));imgs[o.asset]=im;}
          if(im){p.drawImage(im,{...place(o.x,o.y,o.w,o.h),opacity:o.opacity??1});continue;}}
      }catch(e){console.warn('vector export failed, rasterizing',o.type,e);}
      const{c,b}=await rasterObj(o,o.type==='text'||o.type==='glyphtext'?5:4);const im=await out.embedPng(await canvasPng(c));p.drawImage(im,place(b.x,b.y,b.w,b.h));
      if(o.type==='text'||o.type==='glyphtext'){if(!fonts.Helvetica)fonts.Helvetica=await out.embedFont(StandardFonts.Helvetica);addTextLayer(p,o,conv,r,fonts.Helvetica);}
    }
    if(pg.ocr&&pg.ocr.length){if(!fonts.Helvetica)fonts.Helvetica=await out.embedFont(StandardFonts.Helvetica);for(const q of pg.ocr){const L=ocrLine(q);if((pg.edited||[]).includes(L.key))continue;addTextLayer(p,{type:'ocrline',t:L.str,x:L.x,y:L.baseline,w:L.w,size:L.size},conv,r,fonts.Helvetica);}}
  }
  out.setProducer('Folio PDF Editor');out.setTitle(d.name);
  if(opt&&opt.compress)opt.result=await compressImages(out,opt.compress);
  if(opt&&opt.capture){opt.doc=out;opt.preRefs=new Set(out.context.enumerateIndirectObjects().map(([r])=>r.toString()));}   // for size estimates: only objects that exist before saving
  return out.save();
}
async function saveDoc(asNew){
  const d=curDoc();if(!d)return toast('Nothing to save');endEdit();busy(true,'Building PDF…');
  try{const bytes=await buildPdf(d);const blob=new Blob([bytes],{type:'application/pdf'});const name=(d.name||'document')+(d.name.endsWith('-edited')?'':'-edited')+'.pdf';
    if(NATIVE){busy(false);const r=await nativeCall({cmd:"save",name,path:asNew?null:(d.path||null),dir:d.srcPath||null,data:toB64(bytes)});if(!r)return;d.path=r;d.dirty=false;renderTabs();toast("Saved "+String(r).split("/").pop());return;}
    if(window.showSaveFilePicker){try{busy(false);const h=await showSaveFilePicker({suggestedName:name,types:[{description:'PDF',accept:{'application/pdf':['.pdf']}}]});const w=await h.createWritable();await w.write(blob);await w.close();d.dirty=false;renderTabs();toast('Saved '+h.name);return;}catch(e){if(e.name==='AbortError')return;}}
    const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),4000);d.dirty=false;renderTabs();toast('Downloaded '+name);
  }catch(e){console.error(e);toast('Save failed: '+e.message,5000);}finally{busy(false);}
}
async function printDoc(){const d=curDoc();if(!d)return;endEdit();busy(true,'Preparing print…');try{const bytes=await buildPdf(d);if(NATIVE){await nativeCall({cmd:"print",name:d.name,data:toB64(bytes)});return;}const url=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'}));const f=el('iframe');f.style.cssText='position:fixed;right:0;bottom:0;width:1px;height:1px;border:0;opacity:0';f.src=url;document.body.append(f);f.onload=()=>{setTimeout(()=>{try{f.contentWindow.focus();f.contentWindow.print();}catch(e){window.open(url);}},300);};}catch(e){toast('Print failed: '+e.message);}finally{busy(false);}}

