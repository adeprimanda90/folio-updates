  if(t==='edittext')toast('Click any text line to edit it. Scanned or handwritten text? Use Smart erase + Handwriting text.',4200);
  if(t==='snip')toast('Drag a box around the element (signature, logo, stamp…) to copy it',3000);
  if(t==='glyphcap')toast('Drag a box around a handwritten word or letters',3000);
