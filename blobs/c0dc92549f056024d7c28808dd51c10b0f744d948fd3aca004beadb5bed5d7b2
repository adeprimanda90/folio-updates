function makeStamp(text,color,sub){const c=document.createElement('canvas');const x=c.getContext('2d');const fs=56;x.font=`800 ${fs}px Inter, Helvetica, sans-serif`;const w=Math.ceil(x.measureText(text).width)+70;const h=sub?130:100;c.width=w;c.height=h;
