function removeBg(src,thr=200,soft=50){
  const c=cloneCanvas(src),x=c.getContext('2d',{willReadFrequently:true});const id=x.getImageData(0,0,c.width,c.height),d=id.data;
  for(let i=0;i<d.length;i+=4){const r=d[i],g=d[i+1],b=d[i+2],A=d[i+3]/255;const L=.299*r+.587*g+.114*b;let a=L>=thr?0:L>thr-soft?(thr-L)/soft:1;a*=A;
    if(a<=0){d[i+3]=0;continue;}const un=v=>clamp((v-(1-a)*255)/a,0,255);if(a<1){d[i]=un(r);d[i+1]=un(g);d[i+2]=un(b);}d[i+3]=Math.round(a*255);}
  x.putImageData(id,0,0);return c;
}
/* Ruled-line (notebook / book line) removal.
   Finds long, thin, near-horizontal lines (handles a few degrees of tilt), erases them,
   keeps pen strokes that are darker or a different color than the lines, and re-joins
   strokes the line passed through by filling the gap from the ink above and below. */
function removeRuledLines(src){
  const c=cloneCanvas(src),ctx=c.getContext('2d',{willReadFrequently:true}),w=c.width,h=c.height,N=w*h;
  const img=ctx.getImageData(0,0,w,h),d=img.data,lum=new Float32Array(N);
  let transparent=0;const sampleL=[];
  for(let i=0;i<N;i++){const p=i*4;lum[i]=.299*d[p]+.587*d[p+1]+.114*d[p+2];if(d[p+3]<20)transparent++;else if(i%5===0)sampleL.push(lum[i]);}
  sampleL.sort((a,b)=>a-b);const bgL=sampleL.length?sampleL[Math.floor(sampleL.length*.85)]:255;const transBg=transparent>N*.2;
  const fg=new Uint8Array(N);for(let i=0;i<N;i++)fg[i]=d[i*4+3]>=20&&(transBg||lum[i]<bgL-18)?1:0;
  // background colour (for opaque images)
  let br=0,bgc=0,bb=0,bn=0;if(!transBg)for(let i=0;i<N;i+=3)if(!fg[i]&&d[i*4+3]>200){br+=d[i*4];bgc+=d[i*4+1];bb+=d[i*4+2];bn++;}
  const BG=bn?[br/bn,bgc/bn,bb/bn]:[255,255,255];
  // find the skew that makes the row profile sharpest
  const profile=(t,step)=>{const off=Math.ceil(Math.abs(t)*w)+1,R=h+2*off,cnt=new Float32Array(R),tot=new Float32Array(R);
    for(let y=0;y<h;y++){const row=y*w;for(let x=0;x<w;x+=step){const r=Math.round(y-x*t)+off;tot[r]++;if(fg[row+x])cnt[r]++;}}return{off,R,cnt,tot};};
  let best=null;const step=w>1200?3:2;
  for(let a=-5;a<=5.001;a+=.25){const t=Math.tan(a*Math.PI/180),P=profile(t,step);let sc=0;for(let r=0;r<P.R;r++)sc+=P.cnt[r]*P.cnt[r];if(!best||sc>best.sc)best={sc,t,a};}
  const t=best.t,P=profile(t,1),cov=r=>P.tot[r]?P.cnt[r]/P.tot[r]:0;
  // bands of rows that run across most of the picture
  const bands=[],maxThick=Math.max(10,h*.08);
  for(let r=0;r<P.R;r++){
    if(P.tot[r]<w*.5||cov(r)<.42)continue;let r1=r;while(r1+1<P.R&&P.tot[r1+1]>=w*.5&&cov(r1+1)>=.42)r1++;
    if(r1-r+1<=maxThick){let a0=r,a1=r1;if(a0>0&&cov(a0-1)>=.12)a0--;if(a1<P.R-1&&cov(a1+1)>=.12)a1++;bands.push([a0,a1]);}
    r=r1;
  }
  if(!bands.length)return{canvas:src,count:0,angle:0};
  // typical line colour
  let lr=0,lg=0,lb=0,ln=0;for(const[a0,a1]of bands)for(let r=a0;r<=a1;r++)for(let x=0;x<w;x+=2){const y=Math.round(r-P.off+x*t);if(y<0||y>=h)continue;const i=y*w+x;if(fg[i]){lr+=d[i*4];lg+=d[i*4+1];lb+=d[i*4+2];ln++;}}
  const LC=[lr/ln,lg/ln,lb/ln],LL=.299*LC[0]+.587*LC[1]+.114*LC[2];
  const isInk=i=>fg[i]&&(lum[i]<LL-45||Math.hypot(d[i*4]-LC[0],d[i*4+1]-LC[1],d[i*4+2]-LC[2])>95);
  const kill=new Uint8Array(N),band=new Uint8Array(N);
  for(const[a0,a1]of bands)for(let x=0;x<w;x++)for(let r=a0;r<=a1;r++){const y=Math.round(r-P.off+x*t);if(y<0||y>=h)continue;const i=y*w+x;band[i]=1;if(!isInk(i))kill[i]=1;}
  // re-join pen strokes that cross a line
  const inkAt=(x,y)=>x>=0&&x<w&&y>=0&&y<h&&!band[y*w+x]&&fg[y*w+x];
  for(const[a0,a1]of bands)for(let x=0;x<w;x++){
    const yt=Math.round(a0-P.off+x*t),yb=Math.round(a1-P.off+x*t);let up=null,dn=null;
    for(let k=1;k<=3&&!up;k++)if(inkAt(x,yt-k))up=(yt-k)*w+x;
    for(let k=1;k<=3&&!dn;k++)for(const dx of[0,-1,1,-2,2])if(inkAt(x+dx,yb+k)){dn=(yb+k)*w+x+dx;break;}
    if(up==null||dn==null)continue;
    for(let y=Math.max(0,yt);y<=Math.min(h-1,yb);y++){const i=y*w+x;if(!kill[i])continue;const f=(y-yt+1)/(yb-yt+2);
      for(let k=0;k<4;k++)d[i*4+k]=Math.round(d[up*4+k]*(1-f)+d[dn*4+k]*f);kill[i]=0;}
  }
  for(let i=0;i<N;i++)if(kill[i]){const p=i*4;if(transBg)d[p+3]=0;else{d[p]=BG[0];d[p+1]=BG[1];d[p+2]=BG[2];}}
  ctx.putImageData(img,0,0);return{canvas:c,count:bands.length,angle:best.a};
}
function trimCanvas(c,pad=2){
  const x=c.getContext('2d',{willReadFrequently:true});const{width:W,height:H}=c;const d=x.getImageData(0,0,W,H).data;let x0=W,y0=H,x1=-1,y1=-1;
  for(let y=0;y<H;y++)for(let xx=0;xx<W;xx++){if(d[(y*W+xx)*4+3]>10){if(xx<x0)x0=xx;if(xx>x1)x1=xx;if(y<y0)y0=y;if(y>y1)y1=y;}}
  if(x1<0)return{canvas:c,x:0,y:0,empty:true};x0=Math.max(0,x0-pad);y0=Math.max(0,y0-pad);x1=Math.min(W-1,x1+pad);y1=Math.min(H-1,y1+pad);
  const n=document.createElement('canvas');n.width=x1-x0+1;n.height=y1-y0+1;n.getContext('2d').drawImage(c,x0,y0,n.width,n.height,0,0,n.width,n.height);return{canvas:n,x:x0,y:y0};
}
function cropCanvas(c,x,y,w,h){const n=document.createElement('canvas');n.width=Math.max(1,w);n.height=Math.max(1,h);n.getContext('2d').drawImage(c,x,y,w,h,0,0,w,h);return n;}
async function captureRegion(i,r,scale=4,withObjs=true){
  const pg=curDoc().pages[i];const c=document.createElement('canvas');c.width=Math.max(1,Math.round(r.w*scale));c.height=Math.max(1,Math.round(r.h*scale));
  const ctx=c.getContext('2d',{willReadFrequently:true});ctx.fillStyle='#fff';ctx.fillRect(0,0,c.width,c.height);
  if(pg.srcId){const p=await getRenderPage(pg);const vp=p.getViewport({scale,rotation:totalRot(pg),offsetX:-r.x*scale,offsetY:-r.y*scale});await p.render({canvasContext:ctx,viewport:vp}).promise;}
  if(withObjs){ctx.save();ctx.scale(scale,scale);ctx.translate(-r.x,-r.y);for(const o of [...pg.objects,...await pageFormObjs(curDoc(),pg,false)]){await ensureReady(o);drawObjCanvas(ctx,o);}ctx.restore();}
  return c;
}
async function ensureReady(o){try{if(o.type==='text')await document.fonts.load(fontStr(o,20),o.text||'A');if(o.type==='image')await loadImg(o.asset);if(o.type==='glyphtext')await document.fonts.load(`20px ${fontCss({font:o.handFont||'Caveat'})}`);}catch(e){}}
function segmentInk(m){
  const W=m.width,H=m.height,d=m.getContext('2d',{willReadFrequently:true}).getImageData(0,0,W,H).data;const col=new Uint32Array(W);
  for(let y=0;y<H;y++)for(let x=0;x<W;x++)if(d[(y*W+x)*4+3]>70)col[x]++;
  const gapMin=Math.max(2,Math.round(H*.02));const runs=[];let s=-1,gap=0;
  for(let x=0;x<=W;x++){const ink=x<W&&col[x]>0;if(ink){if(s<0)s=x;gap=0;}else if(s>=0){gap++;if(gap>=gapMin||x===W){runs.push([s,x-gap]);s=-1;gap=0;}}}
  const tot=runs.reduce((a,[a0,a1])=>{let n=0;for(let x=a0;x<=a1;x++)n+=col[x];return a+n;},0);
  return runs.filter(([a0,a1])=>{let n=0;for(let x=a0;x<=a1;x++)n+=col[x];return n>tot*.004;}).map(([x0,x1])=>vbounds(d,W,H,x0,x1));
}
function vbounds(d,W,H,x0,x1){let y0=H,y1=-1;for(let y=0;y<H;y++)for(let x=x0;x<=x1;x++)if(d[(y*W+x)*4+3]>70){if(y<y0)y0=y;if(y>y1)y1=y;break;}if(y1<0){y0=0;y1=H-1;}return{x0,x1,y0,y1};}
function splitEven(m,n){const W=m.width,H=m.height,d=m.getContext('2d',{willReadFrequently:true}).getImageData(0,0,W,H).data;const all=segmentInk(m);if(!all.length||n<1)return[];const X0=Math.min(...all.map(s=>s.x0)),X1=Math.max(...all.map(s=>s.x1));const out=[];for(let k=0;k<n;k++){const a=Math.round(X0+(X1-X0+1)*k/n),b=Math.round(X0+(X1-X0+1)*(k+1)/n)-1;out.push(vbounds(d,W,H,a,Math.max(a,b)));}return out;}
function inkColor(m,s){const x=m.getContext('2d',{willReadFrequently:true});const d=x.getImageData(s.x0,s.y0,s.x1-s.x0+1,s.y1-s.y0+1).data;let r=0,g=0,b=0,n=0;for(let i=0;i<d.length;i+=4){const a=d[i+3]/255;if(a>.6){r+=d[i];g+=d[i+1];b+=d[i+2];n++;}}return n?rgb2hex(r/n,g/n,b/n):'#1a1a1a';}
function maskOnly(c){const n=cloneCanvas(c);const x=n.getContext('2d');x.globalCompositeOperation='source-in';x.fillStyle='#000';x.fillRect(0,0,n.width,n.height);return n;}

