function addObj(i,o,{select:sel=true,undo=true}={}){if(undo)pushUndo();o.id=o.id||nid('o');curDoc().pages[i].objects.push(o);renderOverlay(i);if(sel)select(i,o.id);return o;}
function createText(i,pt){const D=S.defaults;const o={type:'text',x:pt.x,y:pt.y-D.fontSize*.6,text:'',fontSize:D.fontSize,color:D.color,font:D.font,detected:D.detected||undefined,bold:D.bold,italic:D.italic,lineHeight:1.2,opacity:1};if(o.font==='__detected'&&!o.detected)o.font='Helvetica';addObj(i,o);startEditText(i,o,{noUndo:true});}
function createGlyphText(i,pt){const D=S.defaults;const o={type:'glyphtext',x:pt.x,y:pt.y-D.glyphSize*.8,text:'',size:D.glyphSize,color:D.color,spacing:.1,seed:Math.floor(Math.random()*1e6),handFont:D.handFont,useInk:false,opacity:1};addObj(i,o);setTool('select',true);setTimeout(()=>$('#props [data-p=text]')?.focus(),30);if(!glyphCount())toast('Tip: capture letters from the document in the Handwriting panel so typed text uses the real handwriting. Until then a handwriting font is used.',5000);}
function createNote(i,pt){const o={type:'note',x:pt.x-11,y:pt.y-11,text:'',color:S.defaults.noteColor,opacity:1};addObj(i,o);setTool('select',true);setTimeout(()=>$('#props [data-p=text]')?.focus(),30);}
async function createMarkup(i,r,type){
  const lines=await getLines(i);const out=[];const tiny=r.w<3&&r.h<3;
  for(const l of lines){const ix=Math.max(l.x,r.x),ax=Math.min(l.x+l.w,r.x+r.w);const iy=Math.max(l.top,r.y),ay=Math.min(l.bot,r.y+r.h);
    if(tiny){if(r.x>=l.x&&r.x<=l.x+l.w&&r.y>=l.top&&r.y<=l.bot)out.push({x:l.x,y:l.top,w:l.w,h:l.h});}else if(ax>ix&&ay>iy&&(ay-iy)>l.h*.3)out.push({x:ix,y:l.top,w:ax-ix,h:l.h});}
  if(!out.length){if(tiny)return;out.push(r);}
  pushUndo();const color=type==='highlight'?S.defaults.hl:S.defaults.ul;let last;
  for(const b of out)last=addObj(i,{type,...b,color,opacity:type==='highlight'?.45:1},{undo:false,select:false});
  select(i,last.id);
}
function startPlacingImage(url,maxW=200){const id=addAsset(url);loadImg(id).then(im=>{let w=im.naturalWidth/2,h=im.naturalHeight/2;if(w>maxW){h*=maxW/w;w=maxW;}S.placing={asset:id,w,h};const g=$('#ghost');g.innerHTML=`<img src="${url}" style="width:100%;height:100%">`;g.style.width=w*S.zoom+'px';g.style.height=h*S.zoom+'px';$('#viewer').classList.add('placing');toast('Click on the page to place it — Esc to cancel');});}
function placeAt(i,pt){const P=S.placing;cancelPlacing();addObj(i,{type:'image',asset:P.asset,x:pt.x-P.w/2,y:pt.y-P.h/2,w:P.w,h:P.h,opacity:1});setTool('select',true);}
function cancelPlacing(){S.placing=null;$('#ghost').style.display='none';$('#viewer').classList.remove('placing');}

/* ================= text editing ================= */
function startEditText(i,o,opt={}){
  const e=elFor(o);if(!e)return;if(!opt.noUndo)pushUndo();S.editing={page:i,id:o.id};
  try{e.contentEditable='plaintext-only';}catch(_){}if(e.contentEditable!=='plaintext-only')e.contentEditable='true';
  e.classList.add('editing');e.spellcheck=false;drawSel();e.focus();
  const r=document.createRange();r.selectNodeContents(e);if(opt.caret!=='all')r.collapse(false);const s=getSelection();s.removeAllRanges();s.addRange(r);
  e.oninput=()=>{o.text=e.innerText.replace(/\n$/,'');o.w=e.offsetWidth/S.zoom*(o.hs||1);o.h=e.offsetHeight/S.zoom;drawSel();markDirty();};
  e.onblur=()=>setTimeout(()=>{if(S.editing&&S.editing.id===o.id&&document.activeElement!==e)endEdit();},0);
  e.onkeydown=ev=>{ev.stopPropagation();if(ev.key==='Escape'){ev.preventDefault();e.blur();endEdit();}};
  e.onpaste=ev=>{ev.preventDefault();const t=ev.clipboardData.getData('text/plain');document.execCommand('insertText',false,t);};
}
function endEdit(){
  if(S.cropping)applyCrop();
  const ed=S.editing;if(!ed)return;S.editing=null;const pg=curDoc()?.pages[ed.page];if(!pg)return;const o=pg.objects.find(x=>x.id===ed.id);
  if(o){const e=elFor(o);if(e){o.text=e.innerText.replace(/\n$/,'');}if(!o.text.trim()){pg.objects=pg.objects.filter(x=>x!==o);if(S.sel&&S.sel.id===o.id)S.sel=null;}}
  renderOverlay(ed.page);renderProps();
}

