/* Feedback → Google Form → Google Sheet. The form link can be built in (DEFAULT_FEEDBACK_FORM)
   or pasted in Info ▸ Ideas & feedback. Entries are also kept on this Mac and re-sent when offline. */
const DEFAULT_FEEDBACK_FORM='https://docs.google.com/forms/d/e/1FAIpQLScQw-HsjdXpftFjmzr4QfIS1jGQwSXg74xFHeOQyoQiSHZIkQ/viewform?usp=pp_url&entry.426011067=x&entry.1115075076=y';  // Ade's "Folio feedback" form, responses go to the Google Sheet "Folio feedback (Responses)"
function parseFormLink(u){const m=/docs\.google\.com\/forms\/(?:u\/\d+\/)?d\/(?:e\/)?([^/]+)\/viewform\?([^#]+)/.exec(u||'');if(!m)return null;const ids=[...new URLSearchParams(m[2]).keys()].filter(k=>/^entry\.\d+$/.test(k));if(!ids.length)return null;return{post:`https://docs.google.com/forms/d/e/${m[1]}/formResponse`,text:ids[0],version:ids[1]||null};}
function fbForm(){return parseFormLink(DEFAULT_FEEDBACK_FORM);}
function fbLog(){try{return JSON.parse(localStorage.getItem('folio.feedback')||'[]');}catch(e){return[];}}
function fbSave(L){try{localStorage.setItem('folio.feedback',JSON.stringify(L.slice(-200)));}catch(e){}}
async function postFeedback(f){const F=fbForm();if(!F)return false;const p=new URLSearchParams();p.set(F.text,f.text);if(F.version)p.set(F.version,f.v);
  if(NATIVE){try{const r=await nativeCall({cmd:'feedback',url:F.post,fields:Object.fromEntries(p)});return !!(r&&r.ok);}catch(e){return false;}}  // Mac app: real HTTP status from Google
  try{await fetch(F.post,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:p.toString()});return true;}catch(e){return false;}}
async function sendFeedback(text){const L=fbLog();const f={t:Date.now(),text,v:appVersion(),sent:false};L.push(f);fbSave(L);f.sent=await postFeedback(f);f.ok=f.sent&&!!NATIVE;fbSave(L);return f.sent;}
async function flushFeedback(){const L=fbLog();let ch=false;for(const f of L){if(NATIVE&&f.sent&&!f.ok){f.sent=false;ch=true;}if(!f.sent&&await postFeedback(f)){f.sent=true;f.ok=!!NATIVE;ch=true;}}if(ch)fbSave(L);}
setTimeout(()=>{if(navigator.onLine!==false)flushFeedback();},5000);
/* ---- online updates (Mac app). The native shell checks, verifies the signature and downloads; a new version is used from the next launch. ---- */
function updateMessage(r){
  if(!r)return'';
  switch(r.state){
    case'downloaded':return`Version ${r.version} was downloaded. It will be used the next time you open Folio.${r.notes?' — '+r.notes:''}`;
    case'upToDate':return`You have the latest version (${r.version}).`;
    case'needsApp':return`Version ${r.version} is available, but it needs a new copy of the Folio app (a new .dmg) — it cannot be installed automatically.`;
    case'failed':return`Could not check for updates: ${r.message||'unknown problem'}`;
    case'rolledBack':return'The last update did not start correctly, so Folio went back to its built-in version. That update will not be tried again.';
    case'notConfigured':return'This copy of Folio has no update address built in.';
    default:return'';
  }
}
window.folioUpdate=r=>{   // called by the app after its quiet daily check, or after a rollback
  if(!r)return;if(r.state==='downloaded'||r.state==='needsApp'||r.state==='rolledBack')toast(updateMessage(r),9000);
};
async function renderUpdateCard(B){
  const el0=B.querySelector('#updBody');if(!el0)return;
  if(!NATIVE){el0.textContent='Online updates are part of the Folio Mac app.';return;}
  let info;try{info=await nativeCall({cmd:'updateInfo'});}catch(e){el0.textContent='Update information is not available in this copy.';return;}
  const draw=(msg)=>{
    el0.innerHTML=`${info.active?`Running version <b>${esc(info.active)}</b>, installed by an online update (built-in version: ${esc(info.builtIn)}).`:`Running the built-in version <b>${esc(info.builtIn)}</b>.`}
      ${info.configured?`<label style="display:block;margin:8px 0"><input type="checkbox" id="updAuto" ${info.auto?'checked':''}> Check for updates automatically (about once a day)</label>
      <div class="btnrow"><button class="mini" id="updNow">Check now</button>${info.active?'<button class="mini" id="updReset">Use built-in version</button>':''}</div>
      <div id="updMsg" style="margin-top:8px;color:var(--ink)">${esc(msg||'')}</div>
      <div style="margin-top:8px">Checking contacts GitHub, where the update files are kept; nothing about you or your PDFs is sent. Every update must carry the developer's digital signature, otherwise Folio ignores it. An update that fails to start is removed automatically.</div>`
      :'<div style="margin-top:6px">This copy has no update address built in, so it never checks online. New versions come as a new .dmg.</div>'}`;
    const a=el0.querySelector('#updAuto');if(a)a.onchange=async()=>{info=await nativeCall({cmd:'updateAuto',on:a.checked});};
    const n=el0.querySelector('#updNow');if(n)n.onclick=async()=>{n.disabled=true;n.textContent='Checking…';let r;try{r=await nativeCall({cmd:'updateCheck'});}catch(e){r={state:'failed',message:String(e.message||e)};}draw(updateMessage(r));};
    const x=el0.querySelector('#updReset');if(x)x.onclick=async()=>{info=await nativeCall({cmd:'updateReset'});draw('Folio will use its built-in version the next time you open it.');};
  };
  draw('');
}
function openInfo(tab='tutorial',topic){
  const M=modal('Folio — Info',`<div class="info"><div class="mtabs">${[['tutorial','How to use'],['about','About & version'],['ideas','Ideas & feedback']].map(([k,t])=>`<button data-it="${k}">${t}</button>`).join('')}</div><div id="infoBody"></div></div>`,{wide:true});
  const show=(t,tp)=>{M.bg.querySelectorAll('[data-it]').forEach(b=>b.classList.toggle('on',b.dataset.it===t));const B=M.$('#infoBody');
    if(t==='tutorial'){const cur=TUTORIAL.find(x=>x.id===tp)||TUTORIAL[0];
      B.innerHTML=`<div class="tut"><nav>${TUTORIAL.map(x=>`<button data-tp="${x.id}" class="${x.id===cur.id?'on':''}">${esc(x.t)}</button>`).join('')}</nav><div><h3 style="margin:0 0 10px">${esc(cur.t)}</h3>${cur.gif?`<img class="gif" src="tutorial/${cur.gif}.gif" alt="${esc(cur.t)} — animated demonstration" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'tip',textContent:'(Animated demonstration is included in the Mac app.)'}))">`:''}<ol>${cur.steps.map(x=>`<li>${x}</li>`).join('')}</ol><div class="sign">${cur.sign.map(x=>`<span>${esc(x)}</span>`).join('')}</div></div></div>`;
      B.querySelectorAll('[data-tp]').forEach(b=>b.onclick=()=>show('tutorial',b.dataset.tp));}
    else if(t==='about'){B.innerHTML=`<div class="about"><h2>Folio PDF Editor</h2><div class="ver">Version ${esc(appVersion())}</div>
      <div class="card"><b>Developed by Ade Primanda</b> together with <b>Claude Opus 5.5</b> (Anthropic).<br><span class="tip">Edit PDF text in the original font, sign, copy elements between PDFs, clean signature photos, and organise pages — all on your own Mac.</span></div>
      <div class="card"><b>What's new</b><ul>${CHANGELOG.map(([v,t])=>`<li><b>${v}</b> — ${esc(t)}</li>`).join('')}</ul></div>
      <div class="card" id="updCard"><b>Updates</b><div id="updBody" class="tip" style="margin-top:6px">…</div></div>
      <div class="card"><b>Good to know</b><ul><li>Your files never leave your Mac. The internet is only used to fetch extra fonts from Google Fonts when a PDF uses one, to check for Folio updates, and to send feedback you choose to send.</li><li>Scanned pages are pictures, not text: use Smart erase ${K('X')} and Add text ${K('T')} there.</li></ul></div></div>`;renderUpdateCard(B);}
    else{B.innerHTML=`<div class="about"><div class="card"><b>Ideas for future versions</b><ul>${IDEAS.map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>
      <div class="card"><b>Your suggestion</b><div class="tip" style="margin:4px 0 8px">Found a problem or have an idea? Write it here. Just write it and press Send — Folio adds the version number for you.</div><textarea id="fbText" placeholder="What would make Folio better?"></textarea>
      <div class="btnrow" style="margin-top:8px"><button class="mini" id="fbSend" style="background:var(--accent);color:#fff;border-color:var(--accent)">Send feedback</button><button class="mini" id="fbCopy">Copy</button></div></div>
      <div class="card"><b>Feedback sent from this Mac</b>${(()=>{const L=fbLog();return L.length?`<ul>${L.slice(-8).reverse().map(f=>`<li><span class="tip">${new Date(f.t).toLocaleDateString()} · ${f.sent?'sent':'waiting to send'}</span><br>${esc(f.text.slice(0,140))}</li>`).join('')}</ul>`:'<div class="tip">Nothing yet.</div>';})()}</div></div>`;
      const body=()=>M.$('#fbText').value.trim();
      M.$('#fbCopy').onclick=()=>{navigator.clipboard?.writeText(body()+'\n\n— Folio '+appVersion()).then(()=>toast('Copied')).catch(()=>toast('Could not copy'));};
      M.$('#fbSend').onclick=async()=>{const t=body();if(!t)return toast('Write your suggestion first');const ok=await sendFeedback(t);M.$('#fbText').value='';toast(ok?'Thank you — your feedback was sent':'No internet right now — it will be sent automatically later',4500);show('ideas');};}
  };
  M.bg.querySelectorAll('[data-it]').forEach(b=>b.onclick=()=>show(b.dataset.it));show(tab,topic);return M;
}
async function openSnip(i,r){
  busy(true,'Capturing…');let raw;try{raw=await captureRegion(i,r,4,true);}finally{busy(false);}
  const M=modal('Copy element',`<div class="checker" id="snipPrev"></div>
   <div class="ctl"><label><input type="checkbox" id="snRm" checked> Remove white background</label><label>Threshold <input type="range" id="snTh" min="120" max="250" value="205"></label><label><input type="checkbox" id="snTrim" checked> Trim empty space</label><label><input type="checkbox" id="snMono"> Recolor ink</label><input type="color" id="snCol" value="#1a2b8c"></div>
   <div class="tip">The copied element keeps its original size and position. Paste it with <span class="kbd">Ctrl</span>+<span class="kbd">V</span> onto any page — including other open PDFs. It is also placed on your system clipboard as an image when the browser allows.</div>`);
  let out=null;
  const upd=()=>{let c=raw;if(M.$('#snRm').checked)c=removeBg(raw,+M.$('#snTh').value);if(M.$('#snMono').checked&&M.$('#snRm').checked){const x=c.getContext('2d');x.globalCompositeOperation='source-in';x.fillStyle=M.$('#snCol').value;x.fillRect(0,0,c.width,c.height);}
    let ox=0,oy=0;if(M.$('#snTrim').checked&&M.$('#snRm').checked){const t=trimCanvas(c,6);c=t.canvas;ox=t.x;oy=t.y;}out={c,ox,oy};const p=M.$('#snipPrev');p.innerHTML='';const show=cloneCanvas(c);p.append(show);};
  ['snRm','snTh','snTrim','snMono','snCol'].forEach(id=>M.$('#'+id).oninput=upd);upd();
  const build=()=>{const url=out.c.toDataURL('image/png');return{url,obj:{type:'image',asset:addAsset(url),x:r.x+out.ox/4,y:r.y+out.oy/4,w:out.c.width/4,h:out.c.height/4,opacity:1}};};
  M.btn(icon('save')+' PNG','',()=>{saveDataURLAs(out.c.toDataURL('image/png'),'element.png');});
  const sv=M.btn(icon('lib')+' Save to library','',()=>{const{url,obj}=build();S.lib.sigs.unshift({id:nid('l'),d:url,w:obj.w,h:obj.h});saveLib();if(S.side==='library')renderSide();toast('Saved to library');sv.disabled=true;});
  M.foot.insertBefore(el('div','grow'),M.foot.firstChild);
  M.btn('Cancel','',M.close);
  M.btn(icon('copy')+' Copy','pri',()=>{const{obj}=build();S.clipboard={objs:[obj],doc:curDoc().id,page:i};S.clipStale=false;
    try{out.c.toBlob(b=>{if(b&&navigator.clipboard&&window.ClipboardItem)navigator.clipboard.write([new ClipboardItem({'image/png':b})]).catch(()=>{});});}catch(e){}
    M.close();setTool('select');if(S.side==='library')renderSide();toast('Copied! Go to any page or document and press Ctrl+V to paste.',3600);});
}
async function openGlyphCapture(i,r){
  busy(true,'Capturing handwriting…');let raw;try{raw=await captureRegion(i,r,4,true);}finally{busy(false);}
  const M=modal('Capture handwriting',`<div class="checker" id="gPrev" style="min-height:120px"></div>
   <div class="ctl"><label>Ink threshold <input type="range" id="gTh" min="100" max="245" value="190"></label>
   <label><input type="radio" name="gm" value="auto" checked> Split by gaps</label><label><input type="radio" name="gm" value="even"> Split evenly (joined/cursive)</label><label><input type="radio" name="gm" value="word"> Keep as whole word</label></div>
   <input class="field" id="gTxt" placeholder="Type exactly what this handwriting says, e.g. Budi" autocomplete="off">
   <div class="tip" id="gInfo" style="margin-top:8px"></div>`,{wide:true});
  let mask,segs=[];
  const draw=()=>{const p=M.$('#gPrev');p.innerHTML='';const c=cloneCanvas(mask);const x=c.getContext('2d');x.lineWidth=Math.max(2,c.width/300);segs.forEach((s,k)=>{x.strokeStyle=`hsl(${k*67%360},80%,45%)`;x.strokeRect(s.x0-1,s.y0-1,s.x1-s.x0+3,s.y1-s.y0+3);});p.append(c);};
  const upd=()=>{mask=removeBg(raw,+M.$('#gTh').value,40);const mode=M.$('input[name=gm]:checked').value;const chars=Array.from(M.$('#gTxt').value.replace(/\s+/g,''));
    if(mode==='auto')segs=segmentInk(mask);else if(mode==='even')segs=splitEven(mask,Math.max(1,chars.length));else{const a=segmentInk(mask);segs=a.length?[{x0:Math.min(...a.map(s=>s.x0)),x1:Math.max(...a.map(s=>s.x1)),y0:Math.min(...a.map(s=>s.y0)),y1:Math.max(...a.map(s=>s.y1))}]:[];}
    draw();const info=M.$('#gInfo');
    if(mode==='word')info.innerHTML=`Saved as a whole word — used whenever you type <b>${esc(M.$('#gTxt').value.trim()||'…')}</b>. Individual letters are not learned.`;
    else if(!chars.length)info.innerHTML=`Found <b>${segs.length}</b> piece(s). Type the characters shown, in order.`;
    else if(chars.length===segs.length)info.innerHTML=`<span class="segok">✓ ${segs.length} pieces match ${chars.length} characters.</span> Each colored box becomes a letter: ${chars.map(c=>'<b>'+esc(c)+'</b>').join(' ')}`;
    else info.innerHTML=`<span class="segbad">Found ${segs.length} piece(s) but you typed ${chars.length} character(s).</span> Adjust the threshold, try “Split evenly” for joined letters, or keep as a whole word.`;
    saveB.disabled=!(mode==='word'?M.$('#gTxt').value.trim():chars.length&&chars.length===segs.length);};
  M.foot.append(el('div','grow'));M.btn('Cancel','',M.close);
  const saveB=M.btn('Save handwriting','pri',()=>{
    const mode=M.$('input[name=gm]:checked').value;const txt=M.$('#gTxt').value.trim();const chars=Array.from(txt.replace(/\s+/g,''));
    const bm=maskOnly(mask);const heights=segs.map(s=>s.y1-s.y0+1);let u=median(heights);const base=median(segs.map(s=>s.y1));
    if(mode==='word')u=heights[0]*.55;u=Math.max(4,u);
    const mk=s=>({id:nid('g'),d:cropCanvas(bm,s.x0,s.y0,s.x1-s.x0+1,s.y1-s.y0+1).toDataURL('image/png'),wU:(s.x1-s.x0+1)/u,hU:(s.y1-s.y0+1)/u,bU:mode==='word'?0:(s.y1-base)/u,c:inkColor(mask,s)});
    if(mode==='word'){const g=mk(segs[0]);(S.lib.words[txt]=S.lib.words[txt]||[]).push(g);glyphImg(g);}
    else segs.forEach((s,k)=>{const g=mk(s);(S.lib.glyphs[chars[k]]=S.lib.glyphs[chars[k]]||[]).push(g);glyphImg(g);});
    saveLib();tintCache={};M.close();showSide('hand');renderAllOverlays();toast(mode==='word'?'Word saved':`Learned ${chars.length} letter(s). Capture more words to cover the alphabet.`,3500);setTool('glyphcap');
  });
