function doAction(a){if(!curDoc()){toast('Open a PDF first');return;}if(a==='sign')openSignModal();if(a==='image')$('#fImage').click();if(a==='stamp')openSignModal('stamps');}

/* pointer handling */
function setupPointer(){
  const v=$('#viewer');
  v.addEventListener('pointerdown',e=>{
    if(e.button===1||(e.button===0&&S.tool==='hand')){startPan(e);e.preventDefault();return;}
    if(e.button!==0)return;
    if(e.target.closest('.ffield'))return;
    const wrap=e.target.closest('.pagewrap');
    if(!wrap){if(!e.target.closest('#status')&&S.tool==='select')select(null);return;}
    const i=+wrap.dataset.idx;S.curPage=i;const pt=pagePoint(e,i);
    const h=e.target.closest('.h');if(h&&selObj()){e.preventDefault();startResize(e,S.sel.page,selObj(),h.dataset.dir);return;}
    if(S.placing){e.preventDefault();placeAt(i,pt);return;}
