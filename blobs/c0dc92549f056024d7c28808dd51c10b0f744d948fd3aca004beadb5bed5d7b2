  if(hx&&ox&&!(S.editing&&S.editing.id===ox.dataset.id)){const hb=hx.getBoundingClientRect(),ob=ox.getBoundingClientRect();if(Math.abs(e.clientY-(hb.top+hb.height/2))<Math.abs(e.clientY-(ob.top+ob.height/2))){e.preventDefault();endEdit();convertLine(i,+hx.dataset.li,pt);return;}}}
const oe=e.target.closest('.obj');
    if(oe&&(S.tool==='select'||S.tool==='edittext')){
      const o=findObj(i,oe.dataset.id);if(!o)return;
      if(S.editing&&S.editing.id===o.id)return;
      e.preventDefault();const wasSel=S.sel&&S.sel.id===o.id;select(i,o.id);
      startMove(e,i,o,moved=>{if(!moved&&o.type==='text'&&(S.tool==='edittext'||wasSel))startEditText(i,o);});return;
    }
    const hl=e.target.closest('.hintline');if(hl&&S.tool==='edittext'){e.preventDefault();endEdit();convertLine(i,+hl.dataset.li,pt);return;}
    toolDown(e,i,pt);
  });
  v.addEventListener('dblclick',e=>{const oe=e.target.closest('.obj');if(!oe)return;const i=+oe.dataset.page;const o=findObj(i,oe.dataset.id);if(!o)return;if(o.type==='text'&&!S.editing)startEditText(i,o);else if(o.type==='glyphtext'||o.type==='note')$('#props [data-p=text]')?.focus();else if(o.type==='image')startCrop(i,o);});
  v.addEventListener('pointermove',e=>{if(S.placing){const g=$('#ghost');g.style.display='block';g.style.left=e.clientX-S.placing.w*S.zoom/2+'px';g.style.top=e.clientY-S.placing.h*S.zoom/2+'px';}});
  v.addEventListener('pointerleave',()=>{$('#ghost').style.display='none';});
  v.addEventListener('scroll',onScroll);
// Pinch / ctrl+wheel zoom, anchored under the pointer and batched per frame
