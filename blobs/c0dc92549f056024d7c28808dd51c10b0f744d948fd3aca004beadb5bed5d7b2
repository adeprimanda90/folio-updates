/* ================= keyboard ================= */
function setupKeys(){
  document.addEventListener('keydown',e=>{
    const t=e.target;const typing=t.isContentEditable||/INPUT|TEXTAREA|SELECT/.test(t.tagName);const mod=e.ctrlKey||e.metaKey;
    if(mod&&e.key.toLowerCase()==='s'){e.preventDefault();saveDoc();return;}
    if(mod&&e.key.toLowerCase()==='o'){e.preventDefault();openDialog();return;}
    if(mod&&e.key.toLowerCase()==='p'){e.preventDefault();printDoc();return;}
    if(mod&&e.key.toLowerCase()==='f'){e.preventDefault();showSide('search');setTimeout(()=>$('#sq')?.focus(),20);return;}
    if(typing)return;
    if($('.modalbg'))return;
    if(mod&&e.key.toLowerCase()==='z'){e.preventDefault();e.shiftKey?redo():undo();return;}
    if(mod&&e.key.toLowerCase()==='y'){e.preventDefault();redo();return;}
    if(mod&&e.key.toLowerCase()==='c'){if(selObj()){e.preventDefault();copySel();}else if(S.psel&&S.psel.keys.length){e.preventDefault();copyPsel(false);}return;}
    if(mod&&e.key.toLowerCase()==='x'){if(selObj()){e.preventDefault();cutSel();}else if(S.psel&&S.psel.keys.length){e.preventDefault();copyPsel(true);}return;}
    if(mod&&e.key.toLowerCase()==='d'){e.preventDefault();duplicateSel();return;}
    if(mod&&e.key.toLowerCase()==='v'){if(S.clipboard&&!S.clipStale){e.preventDefault();pasteInternal();}return;}
    if(mod&&(e.key==='='||e.key==='+')){e.preventDefault();setZoom(S.zoom*1.2);return;}
    if(mod&&e.key==='-'){e.preventDefault();setZoom(S.zoom/1.2);return;}
    if(mod&&e.key==='0'){e.preventDefault();fitWidth();return;}
    if(mod)return;
    if(S.psel&&!selObj()){if(e.key==='Delete'||e.key==='Backspace'){e.preventDefault();deletePsel();return;}if(e.key.startsWith('Arrow')){e.preventDefault();const st=e.shiftKey?10:1;movePsel(e.key==='ArrowLeft'?-st:e.key==='ArrowRight'?st:0,e.key==='ArrowUp'?-st:e.key==='ArrowDown'?st:0);return;}if(e.key==='Escape'){clearPsel();return;}}
    if(e.key==='Delete'||e.key==='Backspace'){if(selObj()){e.preventDefault();deleteSel();}return;}
    if(e.key==='Escape'){if(S.placing)cancelPlacing();else if(S.tool!=='select')setTool('select');else select(null);return;}
    if(e.key.startsWith('Arrow')&&selObj()){e.preventDefault();const s=e.shiftKey?10:1;nudge(e.key==='ArrowLeft'?-s:e.key==='ArrowRight'?s:0,e.key==='ArrowUp'?-s:e.key==='ArrowDown'?s:0);return;}
    if(e.key==='Enter'&&selObj()?.type==='image'){e.preventDefault();startCrop(S.sel.page,selObj());return;}
    if(e.key==='Enter'&&selObj()?.type==='text'){e.preventDefault();startEditText(S.sel.page,selObj());return;}
    if(e.key==='PageDown'){scrollToPage(Math.min(S.curPage+1,pageViews.length-1));return;}
    if(e.key==='PageUp'){scrollToPage(Math.max(S.curPage-1,0));return;}
    const tl=TOOLS.find(x=>x.k===e.key.toLowerCase());if(tl&&curDoc()){if(tl.id){if(tl.id==='eyedropper')S._prevTool=S.tool;setTool(tl.id,true);}else doAction(tl.act);}
  });
  document.addEventListener('paste',e=>{
    const t=e.target;if(t.isContentEditable||/INPUT|TEXTAREA/.test(t.tagName))return;if(!curDoc())return;
    const f=[...(e.clipboardData?.items||[])].find(it=>it.type.startsWith('image/'));
    if(f&&(S.clipStale||!S.clipboard)){e.preventDefault();pasteImageBlob(f.getAsFile());return;}
    if(S.clipboard){e.preventDefault();pasteInternal();return;}
    const txt=e.clipboardData?.getData('text/plain');if(txt){e.preventDefault();const i=S.curPage;const[vw,vh]=viewDims(curDoc().pages[i]);const D=S.defaults;const o={type:'text',x:vw*.15,y:vh*.3,text:txt,fontSize:D.fontSize,color:D.color,font:D.font,bold:D.bold,italic:D.italic,lineHeight:1.2,opacity:1};addObj(i,o);}
  });
  window.addEventListener('blur',()=>{S.clipStale=true;});
  window.addEventListener('beforeunload',e=>{if(S.docs.some(d=>d.dirty)){e.preventDefault();e.returnValue='';}});
}

