<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Folio PDF Editor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="fonts/fonts.css" rel="stylesheet">
<link id="fontextra" href="fontextra/fontextra.css" rel="stylesheet">
<link id="fontlib" href="fontlib/fontlib.css" rel="stylesheet">
<script src="lib/pdf.min.js"></script>
<script src="lib/pdf-lib.min.js"></script>
<style>
:root{
  --accent:#d6342b; --accent-2:#b82a22; --accent-soft:#fdecea;
  --ink:#1f1f1f; --ink-2:#4b4b4b; --ink-3:#7a7a7a;
  --bg:#ffffff; --bg-2:#f6f6f6; --bg-3:#ececec; --line:#e1e1e1; --line-2:#cfcfcf;
  --canvas:#e4e4e4; --sel:#1a73e8; --shadow:0 1px 3px rgba(0,0,0,.12),0 4px 14px rgba(0,0,0,.08);
  --r:8px;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font:13px/1.4 Inter,system-ui,-apple-system,Segoe UI,sans-serif;overflow:hidden}
button{font:inherit;color:inherit}
input,select,textarea{font:inherit;color:inherit}
#app{display:grid;grid-template-rows:46px 46px minmax(0,1fr);grid-template-columns:minmax(0,1fr);height:100vh;overflow:hidden}
/* header */
#hdr{display:flex;align-items:center;gap:10px;padding:0 12px;border-bottom:1px solid var(--line);background:var(--bg)}
.logo{display:flex;align-items:center;gap:8px;font-weight:700;font-size:15px;letter-spacing:-.2px;margin-right:6px;white-space:nowrap}
.logo .mk{width:26px;height:26px;border-radius:6px;background:var(--accent);display:grid;place-items:center;color:#fff}
#tabs{display:flex;gap:2px;flex:1;overflow-x:auto;scrollbar-width:none;align-self:stretch;align-items:flex-end}
.dtab{display:flex;align-items:center;gap:6px;padding:7px 8px 7px 12px;border:1px solid transparent;border-bottom:none;border-radius:8px 8px 0 0;cursor:pointer;max-width:220px;white-space:nowrap;color:var(--ink-2);margin-bottom:-1px}
.dtab span{overflow:hidden;text-overflow:ellipsis}
.dtab.on{background:var(--bg-2);border-color:var(--line);color:var(--ink);font-weight:500}
.dtab .cx{border:none;background:none;width:18px;height:18px;border-radius:4px;cursor:pointer;color:var(--ink-3);display:grid;place-items:center;padding:0}
.dtab .cx:hover{background:var(--bg-3);color:var(--ink)}
.dtab .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}
.hbtn{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 12px;border:1px solid var(--line-2);border-radius:16px;background:var(--bg);cursor:pointer;white-space:nowrap}
.hbtn:hover{background:var(--bg-2)}
.hbtn.pri{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:500}
.hbtn.pri:hover{background:var(--accent-2)}
.hbtn svg{width:16px;height:16px}
/* toolbar */
#tb{display:flex;align-items:center;gap:2px;padding:0 10px;border-bottom:1px solid var(--line);background:var(--bg-2);overflow-x:auto;scrollbar-width:thin}
.tbtn{width:34px;height:34px;flex:0 0 34px;border:none;background:none;border-radius:7px;display:grid;place-items:center;cursor:pointer;color:var(--ink-2);position:relative}
.tbtn:hover{background:var(--bg-3);color:var(--ink)}
.tbtn.on{background:var(--accent-soft);color:var(--accent)}
.tbtn:disabled{opacity:.35;cursor:default;background:none}
.tbtn svg{width:19px;height:19px}
.tsep{width:1px;height:22px;background:var(--line-2);margin:0 6px;flex:0 0 1px}
.tbtn[data-tip]:hover::after{content:attr(data-tip);position:fixed;transform:translate(-50%,30px);background:#2b2b2b;color:#fff;padding:5px 8px;border-radius:5px;font-size:11.5px;white-space:nowrap;pointer-events:none;z-index:999;margin-left:17px;left:auto}
#tbr{margin-left:auto;display:flex;align-items:center;gap:4px}
/* main */
#main{display:flex;min-height:0;min-width:0;overflow:hidden}
#rail{width:48px;border-right:1px solid var(--line);background:var(--bg);display:flex;flex-direction:column;align-items:center;padding-top:8px;gap:4px}
#side{width:236px;border-right:1px solid var(--line);background:var(--bg);display:flex;flex-direction:column;min-height:0}
#side.hidden{display:none}
.sideh{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;font-weight:600;border-bottom:1px solid var(--line)}
.sideb{flex:1;overflow:auto;padding:10px}
.mini{border:1px solid var(--line-2);background:var(--bg);border-radius:6px;height:26px;padding:0 8px;cursor:pointer;font-size:12px;display:inline-flex;align-items:center;gap:5px}
.mini:hover{background:var(--bg-2)}
.mini svg{width:14px;height:14px}
.mini.pri{background:var(--accent);color:#fff;border-color:var(--accent)}
#viewer{flex:1 1 0;width:0;overflow:auto;overscroll-behavior:contain;background:var(--canvas);position:relative;min-width:0}
#pages{display:flex;flex-direction:column;align-items:center;gap:18px;padding:24px 30px 90px;min-width:max-content}
.pagewrap{position:relative;background:#fff;box-shadow:var(--shadow);flex:0 0 auto}
.pcanvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hint,.ov{position:absolute;inset:0}
.ov{pointer-events:none}
.hint{pointer-events:none}
.tool-edittext .hint{pointer-events:auto}
.hintline{position:absolute;border:1px solid rgba(26,115,232,.45);border-radius:2px;cursor:text}
.hintline:hover{background:rgba(26,115,232,.08);border-color:var(--sel)}
.obj{position:absolute;pointer-events:none;user-select:none}
.tool-select .obj,.tool-edittext .obj{pointer-events:auto;cursor:move}
.textobj{white-space:pre;padding:0;margin:0;outline:none;font-kerning:normal;transform-origin:0 0}
.textobj.editing{cursor:text;user-select:text;outline:1px dashed var(--sel);outline-offset:1px;-webkit-user-modify:read-write-plaintext-only}
.tool-edittext .textobj{cursor:text}
.obj.hl{mix-blend-mode:multiply}
.noteicon{width:22px;height:22px;border-radius:4px 4px 4px 0;display:grid;place-items:center;box-shadow:0 1px 3px rgba(0,0,0,.3)}
.noteicon svg{width:14px;height:14px;color:#3a2f00}
.selbox{position:absolute;outline:1.5px solid var(--sel);pointer-events:none;outline-offset:1px}
.selbox .h{position:absolute;width:9px;height:9px;background:#fff;border:1.5px solid var(--sel);border-radius:2px;pointer-events:auto;margin:-5px 0 0 -5px}
.h[data-dir=nw],.h[data-dir=se]{cursor:nwse-resize}.h[data-dir=ne],.h[data-dir=sw]{cursor:nesw-resize}
.thumb.sel canvas{outline:3px solid var(--sel);outline-offset:1px}
.pselbar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:6px 8px;margin:0 0 8px;border:1px solid var(--line);border-radius:8px;background:rgba(26,115,232,.06);font-size:12px}
.cprow{display:grid;grid-template-columns:18px 78px 86px 96px 1fr;align-items:center;gap:8px;padding:7px 8px;border:1px solid var(--line);border-radius:8px;margin:5px 0;cursor:pointer}
.cprow:has(input[type=radio]:checked){border-color:var(--sel);background:rgba(26,115,232,.06)}
.cprow .s{font-weight:600}.cprow .p,.cprow .d{color:var(--ink-3);font-size:12px}
.cprow.tg{grid-template-columns:18px auto 80px 96px 1fr}
.formlayer{position:absolute;inset:0;pointer-events:none;z-index:20}
.ffield{position:absolute;pointer-events:auto;box-sizing:border-box;margin:0;border:1px solid rgba(26,115,232,.55);background:rgba(226,238,255,.94);border-radius:2px;font-family:Helvetica,Arial,sans-serif;color:#000;padding:0 2px;outline:none;line-height:1.2}
.ffield:focus{border-color:var(--sel);background:#fff;box-shadow:0 0 0 2px rgba(26,115,232,.25)}
textarea.ffield{resize:none;padding:2px}
.ffield.ff-check,.ffield.ff-radio{padding:0;border:0;background:none;accent-color:#1a73e8;cursor:pointer}
.pselbox{position:absolute;outline:1.5px dashed #e8710a;outline-offset:2px;background:rgba(232,113,10,.08);pointer-events:none;z-index:30}
.cropui{position:absolute;z-index:40;pointer-events:auto;cursor:crosshair;touch-action:none}
.cropui img{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;user-select:none;-webkit-user-drag:none}
.cropui .cdim{opacity:.32;filter:saturate(.4)}
.cropui .cbox{position:absolute;outline:1.5px solid var(--sel);box-shadow:inset 0 0 0 1px rgba(255,255,255,.85);cursor:move;background-image:linear-gradient(90deg,transparent calc(33.33% - .5px),rgba(255,255,255,.7) calc(33.33% - .5px),rgba(255,255,255,.7) calc(33.33% + .5px),transparent calc(33.33% + .5px),transparent calc(66.66% - .5px),rgba(255,255,255,.7) calc(66.66% - .5px),rgba(255,255,255,.7) calc(66.66% + .5px),transparent calc(66.66% + .5px)),linear-gradient(0deg,transparent calc(33.33% - .5px),rgba(255,255,255,.7) calc(33.33% - .5px),rgba(255,255,255,.7) calc(33.33% + .5px),transparent calc(33.33% + .5px),transparent calc(66.66% - .5px),rgba(255,255,255,.7) calc(66.66% - .5px),rgba(255,255,255,.7) calc(66.66% + .5px),transparent calc(66.66% + .5px))}
.cropui .h{position:absolute;width:11px;height:11px;background:#fff;border:1.5px solid var(--sel);border-radius:2px;margin:-6px 0 0 -6px}
.cropbar{position:absolute;display:flex;gap:6px;white-space:nowrap;margin-top:10px;z-index:41}
.cropbar button{border:1px solid var(--line);background:var(--bg);border-radius:6px;padding:5px 10px;font-weight:600;cursor:pointer;box-shadow:var(--shadow)}
.cropbar button[data-c=apply]{background:var(--sel);color:#fff;border-color:var(--sel)}
.h[data-dir=n],.h[data-dir=s]{cursor:ns-resize}.h[data-dir=e],.h[data-dir=w]{cursor:ew-resize}
.rubber{position:absolute;border:1.5px dashed var(--sel);background:rgba(26,115,232,.07);pointer-events:none}
.rubber.snip{border-color:var(--accent);background:rgba(214,52,43,.06)}
.flash{position:absolute;background:rgba(255,200,0,.45);pointer-events:none;border-radius:2px;animation:fl 1.6s ease forwards}
@keyframes fl{0%,60%{opacity:1}100%{opacity:0}}
#viewer.tool-hand,#viewer.tool-hand .pagewrap,#viewer.tool-hand .obj{cursor:grab}
.tool-addtext .pagewrap,.tool-handtext .pagewrap{cursor:text}
.tool-ink .pagewrap,.tool-rect .pagewrap,.tool-ellipse .pagewrap,.tool-line .pagewrap,.tool-arrow .pagewrap,.tool-snip .pagewrap,.tool-glyphcap .pagewrap,.tool-whiteout .pagewrap,.tool-highlight .pagewrap,.tool-underline .pagewrap,.tool-strike .pagewrap,.tool-note .pagewrap{cursor:crosshair}
.tool-eyedropper .pagewrap,.tool-matchstyle .pagewrap{cursor:copy}
.placing .pagewrap{cursor:copy}
#ghost{position:fixed;pointer-events:none;opacity:.75;z-index:50;display:none;outline:1px dashed var(--sel)}
/* status */
#status{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.97);border:1px solid var(--line);border-radius:22px;padding:4px 8px;box-shadow:var(--shadow);z-index:20}
#status .tbtn{width:30px;height:30px;flex-basis:30px}
#status input{width:38px;text-align:center;border:1px solid var(--line-2);border-radius:5px;height:24px}
#status select{border:1px solid var(--line-2);border-radius:5px;height:26px;background:#fff}
#viewerwrap{flex:1 1 0;width:0;position:relative;display:flex;min-width:0;overflow:hidden}
/* props */
#props{width:270px;border-left:1px solid var(--line);background:var(--bg);overflow:auto;padding:0 0 20px}
.ph{padding:12px 14px;font-weight:600;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px}
.ph small{font-weight:400;color:var(--ink-3)}
.pg{padding:10px 14px;border-bottom:1px solid var(--line)}
.pg h4{margin:0 0 8px;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-3);font-weight:600}
.prow{display:flex;align-items:center;gap:8px;margin:6px 0}
.prow label{flex:0 0 74px;color:var(--ink-2);font-size:12px}
.prow input[type=number],.prow select,.prow input[type=text]{flex:1;min-width:0;height:28px;border:1px solid var(--line-2);border-radius:6px;padding:0 8px;background:#fff}
.prow input[type=range]{flex:1;accent-color:var(--accent)}
.prow input[type=color]{width:34px;height:28px;padding:0;border:1px solid var(--line-2);border-radius:6px;background:#fff;cursor:pointer}
.ptext{width:100%;min-height:80px;border:1px solid var(--line-2);border-radius:6px;padding:8px;resize:vertical}
.tog{display:inline-flex;border:1px solid var(--line-2);border-radius:6px;overflow:hidden}
.tog button{border:none;background:#fff;width:32px;height:28px;cursor:pointer;font-weight:700}
.tog button+button{border-left:1px solid var(--line-2)}
.tog button.on{background:var(--accent-soft);color:var(--accent)}
.btnrow{display:flex;flex-wrap:wrap;gap:6px}
.tip{color:var(--ink-3);font-size:12px;line-height:1.5}
.tip b{color:var(--ink-2)}
.kbd{display:inline-block;border:1px solid var(--line-2);border-bottom-width:2px;border-radius:4px;padding:0 4px;font-size:11px;background:#fff}
.swatches{display:flex;gap:4px;flex-wrap:wrap}
.sw{width:20px;height:20px;border-radius:50%;border:1px solid rgba(0,0,0,.15);cursor:pointer}
/* thumbs */
.thumbs{display:flex;flex-direction:column;align-items:center;gap:14px;padding:4px 0}
.thumb{position:relative;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:4px}
.thumb canvas{box-shadow:0 1px 3px rgba(0,0,0,.25);background:#fff;border:2px solid transparent;border-radius:2px}
.thumb.on canvas{border-color:var(--accent)}
.thumb .n{font-size:11px;color:var(--ink-3)}
.thumb .ta{position:absolute;top:4px;right:4px;display:none;flex-direction:column;gap:2px}
.thumb:hover .ta{display:flex}
.thumb .ta button{width:24px;height:24px;border:1px solid var(--line-2);border-radius:5px;background:#fff;display:grid;place-items:center;cursor:pointer;padding:0}
.thumb .ta button:hover{background:var(--bg-2)}
.thumb .ta svg{width:14px;height:14px}
.thumb.dragover canvas{outline:3px solid var(--sel);outline-offset:3px}
/* library */
.libgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.libitem{position:relative;border:1px solid var(--line);border-radius:6px;height:70px;display:grid;place-items:center;cursor:pointer;background:repeating-conic-gradient(#f3f3f3 0 25%,#fff 0 50%) 0 0/12px 12px;padding:6px}
.libitem:hover{border-color:var(--accent)}
.libitem img{max-width:100%;max-height:100%}
.libitem .del{position:absolute;top:2px;right:2px;width:18px;height:18px;border-radius:4px;border:none;background:rgba(255,255,255,.9);cursor:pointer;display:none;padding:0;line-height:1}
.libitem:hover .del{display:block}
.glyphs{display:flex;flex-wrap:wrap;gap:4px}
.glyph{width:40px;height:46px;border:1px solid var(--line);border-radius:5px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:2px;background:#fff;position:relative}
.glyph img{max-width:34px;max-height:28px;margin-top:2px}
.glyph span{font-size:10px;color:var(--ink-3)}
.glyph .del{position:absolute;top:-6px;right:-6px;width:16px;height:16px;border-radius:50%;border:1px solid var(--line-2);background:#fff;font-size:10px;line-height:1;cursor:pointer;display:none;padding:0}
.glyph:hover .del{display:block}
.sres{padding:7px 8px;border-radius:6px;cursor:pointer;font-size:12px}
.sres:hover{background:var(--bg-2)}
.sres b{background:#ffe066;font-weight:600}
.sres small{color:var(--ink-3);display:block}
.sinput{width:100%;height:32px;border:1px solid var(--line-2);border-radius:6px;padding:0 10px}
/* welcome */
#welcome{position:absolute;inset:0;display:grid;place-items:center;background:var(--canvas)}
.wcard{background:#fff;border-radius:14px;box-shadow:var(--shadow);padding:36px 40px;width:min(620px,92%);text-align:center}
.wcard h1{margin:6px 0 6px;font-size:24px;letter-spacing:-.4px}
.wcard p{color:var(--ink-2);margin:0 0 22px}
.drop{border:2px dashed var(--line-2);border-radius:12px;padding:30px;margin-bottom:18px;transition:.15s}
.drop.over{border-color:var(--accent);background:var(--accent-soft)}
.feat{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;text-align:left;margin-top:20px}
.feat div{background:var(--bg-2);border-radius:8px;padding:10px 12px;font-size:12px;color:var(--ink-2)}
.feat b{display:block;color:var(--ink);margin-bottom:2px}
/* modal */
.info .mtabs{margin-bottom:12px}
.tut{display:grid;grid-template-columns:200px 1fr;gap:18px;min-height:420px}
.tut nav{display:flex;flex-direction:column;gap:2px;border-right:1px solid var(--line);padding-right:12px}
.tut nav button{text-align:left;border:0;background:none;padding:8px 10px;border-radius:7px;cursor:pointer;font-weight:500}
.tut nav button.on{background:rgba(214,52,43,.1);color:var(--accent)}
.tut .gif{width:100%;border-radius:10px;border:1px solid var(--line);box-shadow:0 6px 24px rgba(0,0,0,.12);background:#f4f4f4;min-height:120px;display:block}
.tut ol{padding-left:20px;margin:14px 0 6px}.tut li{margin:6px 0;line-height:1.5}
.tut .sign{display:inline-flex;gap:6px;flex-wrap:wrap;margin:6px 0}.tut .sign span{background:#fff4e5;border:1px solid #f3c58a;border-radius:6px;padding:2px 8px;font-size:12px}
.about h2{margin:0 0 2px;font-size:22px}.about .ver{color:var(--muted);margin-bottom:14px}
.about .card{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:10px 0}
.about ul{margin:6px 0;padding-left:20px}.about li{margin:4px 0}
.about textarea{width:100%;min-height:90px;box-sizing:border-box;border:1px solid var(--line);border-radius:8px;padding:8px;font:inherit}.modalbg{position:fixed;inset:0;background:rgba(20,20,20,.45);display:grid;place-items:center;z-index:100}
.modal{background:#fff;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.3);width:min(720px,94vw);max-height:92vh;display:flex;flex-direction:column}
.mh{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--line)}
.mh h3{margin:0;font-size:15px}
.mh .x{border:none;background:none;font-size:22px;cursor:pointer;color:var(--ink-3);line-height:1}
.mb{padding:16px 18px;overflow:auto}
.mf{display:flex;justify-content:flex-end;gap:8px;padding:12px 18px;border-top:1px solid var(--line);align-items:center}
.mf .grow{flex:1}
.mtabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin:-4px 0 14px}
.mtabs button{border:none;background:none;padding:8px 12px;cursor:pointer;border-bottom:2px solid transparent;color:var(--ink-2)}
.mtabs button.on{border-color:var(--accent);color:var(--ink);font-weight:600}
.checker{background:repeating-conic-gradient(#eee 0 25%,#fff 0 50%) 0 0/16px 16px;border:1px solid var(--line);border-radius:8px;display:grid;place-items:center;min-height:160px;padding:10px;position:relative}
.checker canvas,.checker img{max-width:100%;max-height:340px}
#sigpad{width:100%;height:200px;border:1px solid var(--line-2);border-radius:8px;background:#fff;touch-action:none;cursor:crosshair}
.fontchoices{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.fontchoices button{height:64px;border:1px solid var(--line-2);border-radius:8px;background:#fff;cursor:pointer;font-size:28px;overflow:hidden;white-space:nowrap}
.fontchoices button.on{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}
.stamps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stamps button{border:1px solid var(--line);border-radius:8px;background:#fff;padding:10px;cursor:pointer}
.stamps img{max-width:100%}
.field{width:100%;height:36px;border:1px solid var(--line-2);border-radius:8px;padding:0 12px;font-size:14px}
.ctl{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin:10px 0}
.ctl label{display:inline-flex;gap:6px;align-items:center}
.segok{color:#188038;font-weight:600}.segbad{color:var(--accent);font-weight:600}
/* toast */
#toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(20px);background:#2b2b2b;color:#fff;padding:10px 16px;border-radius:8px;opacity:0;transition:.25s;z-index:200;pointer-events:none;max-width:80vw;text-align:center}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#busy{position:fixed;inset:0;background:rgba(255,255,255,.6);display:none;place-items:center;z-index:300;font-weight:600}
#busy.show{display:grid}
.spin{width:28px;height:28px;border:3px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:sp 0.8s linear infinite;margin:0 auto 10px}
@keyframes sp{to{transform:rotate(360deg)}}
@media (max-width:900px){#props{display:none}#side{width:190px}}
</style>
</head>
<body>
